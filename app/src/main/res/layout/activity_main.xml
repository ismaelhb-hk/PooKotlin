<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/Derecha"
            android:layout_width="129dp"
            android:layout_height="42dp"
            android:layout_marginStart="110dp"
            android:layout_marginTop="297dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="178dp"
            android:text="Derecha"
            app:layout_constraintBottom_toTopOf="@+id/CambiarTamaño"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/Izquierda"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/Arriba"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="158dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="16dp"
            android:text="Arriba"
            app:layout_constraintBottom_toTopOf="@+id/Abajo"
            app:layout_constraintEnd_toStartOf="@+id/Derecha"
            app:layout_constraintStart_toEndOf="@+id/Izquierda"
            app:layout_constraintTop_toBottomOf="@+id/view" />

        <View
            android:id="@+id/view"
            android:layout_width="106dp"
            android:layout_height="96dp"
            android:layout_marginStart="150dp"
            android:layout_marginTop="48dp"
            android:layout_marginEnd="155dp"
            android:layout_marginBottom="15dp"
            android:background="@color/RojoPasion"
            app:layout_constraintBottom_toTopOf="@+id/Arriba"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/Abajo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="150dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="150dp"
            android:layout_marginBottom="13dp"
            android:text="Abajo"
            app:layout_constraintBottom_toTopOf="@+id/CambiarTamaño"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/Arriba" />

        <Button
            android:id="@+id/CambiarColor"
            android:layout_width="163dp"
            android:layout_height="50dp"
            android:layout_marginStart="122dp"
            android:layout_marginEnd="126dp"
            android:layout_marginBottom="160dp"
            android:text="Cambiar Color"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/CambiarTamaño" />

        <Button
            android:id="@+id/CambiarTamaño"
            android:layout_width="160dp"
            android:layout_height="44dp"
            android:layout_marginStart="122dp"
            android:layout_marginTop="91dp"
            android:layout_marginEnd="129dp"
            android:layout_marginBottom="50dp"
            android:text="Cambiar Tamaño"
            app:layout_constraintBottom_toTopOf="@+id/CambiarColor"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/Abajo" />

        <Button
            android:id="@+id/Izquierda"
            android:layout_width="129dp"
            android:layout_height="42dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="297dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="178dp"
            android:text="Izquierda"
            app:layout_constraintBottom_toTopOf="@+id/CambiarTamaño"
            app:layout_constraintEnd_toStartOf="@+id/Arriba"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/Reiniciar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="279dp"
            android:layout_marginBottom="6dp"
            android:text="Reiniciar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/CambiarColor" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>